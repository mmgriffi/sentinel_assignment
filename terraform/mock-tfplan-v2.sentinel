raw = {
	"configuration": {
		"provider_config": {
			"aws": {
				"expressions": {
					"region": {
						"references": [
							"var.aws_region",
						],
					},
				},
				"full_name":          "registry.terraform.io/hashicorp/aws",
				"name":               "aws",
				"version_constraint": "~> 6.69",
			},
		},
		"root_module": {
			"outputs": {
				"backup_s3_bucket_name": {
					"description": "The unique name of the S3 bucket created for database backups",
					"expression": {
						"references": [
							"aws_s3_bucket.db_backups.id",
							"aws_s3_bucket.db_backups",
						],
					},
				},
				"backup_s3_uri": {
					"description": "The target S3 URI path to copy backup files directly to",
					"expression": {
						"references": [
							"aws_s3_bucket.db_backups.id",
							"aws_s3_bucket.db_backups",
						],
					},
				},
				"db_endpoint": {
					"description": "The connection endpoint for the MySQL RDS database",
					"expression": {
						"references": [
							"aws_db_instance.mysql_db.endpoint",
							"aws_db_instance.mysql_db",
						],
					},
				},
				"instance_id": {
					"description": "ID of the EC2 instance",
					"expression": {
						"references": [
							"aws_instance.ec2_server.id",
							"aws_instance.ec2_server",
						],
					},
				},
				"instance_private_ip": {
					"description": "Private IP address of the EC2 instance",
					"expression": {
						"references": [
							"aws_instance.ec2_server.private_ip",
							"aws_instance.ec2_server",
						],
					},
				},
				"instance_public_dns": {
					"description": "Public DNS name of the EC2 instance",
					"expression": {
						"references": [
							"aws_instance.ec2_server.public_dns",
							"aws_instance.ec2_server",
						],
					},
				},
				"instance_public_ip": {
					"description": "Public IP address of the EC2 instance",
					"expression": {
						"references": [
							"aws_instance.ec2_server.public_ip",
							"aws_instance.ec2_server",
						],
					},
				},
				"internet_gateway_id": {
					"description": "ID of the Internet Gateway",
					"expression": {
						"references": [
							"aws_internet_gateway.main.id",
							"aws_internet_gateway.main",
						],
					},
				},
				"private_subnet-a_id": {
					"description": "ID of the private subnet A",
					"expression": {
						"references": [
							"aws_subnet.privateB.id",
							"aws_subnet.privateB",
						],
					},
				},
				"private_subnet_id": {
					"description": "ID of the private subnet B",
					"expression": {
						"references": [
							"aws_subnet.privateA.id",
							"aws_subnet.privateA",
						],
					},
				},
				"public_subnet_id": {
					"description": "ID of the public subnet",
					"expression": {
						"references": [
							"aws_subnet.public.id",
							"aws_subnet.public",
						],
					},
				},
				"security_group_id": {
					"description": "ID of the security group",
					"expression": {
						"references": [
							"aws_security_group.ec2_server.id",
							"aws_security_group.ec2_server",
						],
					},
				},
				"ssh_connection_command": {
					"description": "Command to SSH into the EC2 instance",
					"expression": {
						"references": [
							"aws_instance.ec2_server.public_ip",
							"aws_instance.ec2_server",
						],
					},
				},
				"vpc_cidr_block": {
					"description": "CIDR block of the VPC",
					"expression": {
						"references": [
							"aws_vpc.main.cidr_block",
							"aws_vpc.main",
						],
					},
				},
				"vpc_id": {
					"description": "ID of the VPC",
					"expression": {
						"references": [
							"aws_vpc.main.id",
							"aws_vpc.main",
						],
					},
				},
			},
			"resources": [
				{
					"address": "aws_db_instance.mysql_db",
					"expressions": {
						"allocated_storage": {
							"constant_value": 20,
						},
						"availability_zone": {
							"references": [
								"aws_subnet.privateA.availability_zone",
								"aws_subnet.privateA",
							],
						},
						"backup_retention_period": {
							"constant_value": 0,
						},
						"db_subnet_group_name": {
							"references": [
								"aws_db_subnet_group.rds_subnet_group.name",
								"aws_db_subnet_group.rds_subnet_group",
