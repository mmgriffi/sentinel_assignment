						"instance_class": {
							"constant_value": "db.t3.micro",
						},
						"multi_az": {
							"constant_value": false,
						},
						"password": {
							"references": [
								"var.db_password",
							],
						},
						"skip_final_snapshot": {
							"constant_value": true,
						},
						"tags": {
							"references": [
								"var.project_name",
								"var.environment",
							],
						},
						"username": {
							"references": [
								"var.db_username",
							],
						},
						"vpc_security_group_ids": {
							"references": [
								"aws_security_group.db_server.id",
								"aws_security_group.db_server",
							],
						},
					},
					"mode":                "managed",
					"name":                "mysql_db",
					"provider_config_key": "aws",
					"schema_version":      2,
					"type":                "aws_db_instance",
				},
				{
