				"constant_value": "#!/bin/bash\nsudo apt-get update\nsudo apt-get install -y mariadb-client-core awscli\ncurl -o /home/ubuntu/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem\n",
